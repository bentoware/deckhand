{
  "version": "anki-access.v1",
  "transport": {
    "ankiBridge": {
      "direction": "anki_addon_connects_outbound",
      "url": "ws://127.0.0.1:{deckhand_port}/ws/anki",
      "auth": "session_capability_token",
      "encoding": "json_rpc_2_0_messages"
    }
  },
  "toolNamespaces": [
    "anki_context",
    "anki_note",
    "anki_card",
    "anki_review",
    "anki_deck",
    "anki_model",
    "anki_media",
    "anki_export",
    "anki_backup",
    "anki_browser",
    "anki_editor",
    "anki_webengine"
  ],
  "registration": {
    "method": "anki_bridge_hello",
    "protocol": "deckhand.ankiBridge.v1",
    "capabilitiesSource": "addon.command_catalog",
    "reconnect": "replace_same_bridge_id"
  },
  "callEnvelope": {
    "method": "tool.call",
    "params": {
      "bridgeId": "profile-scoped",
      "tool": "anki_context_get_profile",
      "arguments": {}
    }
  }
}
